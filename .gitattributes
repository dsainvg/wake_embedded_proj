# Normalise line endings to LF in the repository, and check them out as LF on
# every platform. Without this, git's core.autocrlf rewrites the tree with CRLF
# on Windows, which breaks CMake configure steps and shell scripts in the
# ESP-IDF build.
* text=auto eol=lf

# ESP-IDF build inputs: CMake and Kconfig parsing are whitespace sensitive and
# CRLF in a .cmake file has caused hard-to-diagnose configure failures.
CMakeLists.txt    text eol=lf
*.cmake           text eol=lf
Kconfig*          text eol=lf
sdkconfig         text eol=lf
sdkconfig.defaults text eol=lf
dependencies.lock text eol=lf
partitions.csv    text eol=lf

# Sources
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.S    text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Windows-native tooling: CRLF is the native format here, and a CRLF shell
# script on the build host is worse than useless.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary artefacts - never line-ending translated, never diffed.
*.wav  binary
*.bin  binary
*.elf  binary
*.map  binary
*.flax binary
*.tflite binary
*.png  binary
*.jpg  binary
*.zip  binary
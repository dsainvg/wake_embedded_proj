# ESP32-S3 N16R8 - wake word detector
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=65536
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ESP-SR: enable the "Hi,ESP" wake word model
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# INMP441
CONFIG_EXAMPLE_I2S_WS_GPIO=40
CONFIG_EXAMPLE_I2S_SCK_GPIO=41
CONFIG_EXAMPLE_I2S_SD_GPIO=42
CONFIG_EXAMPLE_SAMPLE_RATE=16000
CONFIG_EXAMPLE_MIC_SAMPLE_SHIFT=16

# Wake word behaviour
CONFIG_EXAMPLE_WAKENET_THRESHOLD=0.5
CONFIG_EXAMPLE_LED_TYPE_WS2812=y
CONFIG_EXAMPLE_LED_GPIO=48
CONFIG_EXAMPLE_LED_LED_COUNT=1
CONFIG_EXAMPLE_DETECT_COOLDOWN_MS=2000

# Flash clip storage
CONFIG_EXAMPLE_STORAGE_ENABLED=y
CONFIG_EXAMPLE_CLIP_SECONDS=10
CONFIG_EXAMPLE_STORAGE_PARTITION="storage"
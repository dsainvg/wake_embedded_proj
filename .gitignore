# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# Clangd / editor caches
.cache/
.clangd-index/

# Recorded wake word clips pulled off the device by tools/pull_clips.ps1.
# These are test output, not source: ~320 KB per clip and up to 25 slots, so they
# would bloat every commit. Retrieve them with:
#   .\tools\pull_clips.ps1 -Port COM15 -OutDir .\recorded
recorded/
clips/

# NOTE: models/ is intentionally NOT ignored.
# It is reserved for the wake_word_ml git submodule:
#   https://github.com/dsainvg/wakeword_ml.git
# Once added, git tracks it as a submodule (gitlink) and a gitignore rule for
# the path would conflict with that.
